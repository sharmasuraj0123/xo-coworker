{
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": [
      "es2024",
      "dom",
      "dom.iterable"
    ],
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "js/**/*.js",
    "core/**/*.js",
    "core/**/*.d.ts",
    "shell/**/*.js",
    "shell/**/*.d.ts",
    "modules/**/*.js",
    "modules/**/*.d.ts",
    "boot.js",
    "apps-host/**/*.js",
    "apps-host/**/*.d.ts"
  ],
  "exclude": [
    "vendor/**",
    "node_modules/**"
  ]
}
