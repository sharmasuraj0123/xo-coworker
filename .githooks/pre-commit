#!/bin/sh
# Fast checks before every commit (seconds). Turn on once per checkout:
#   git config core.hooksPath .githooks        (or, per worktree, see AGENTS.md)
# The full check (with every unit test) is `node tools/check.mjs`; it runs before every merge.
git diff --cached --check || { echo "pre-commit: whitespace errors in the staged changes"; exit 1; }
exec node tools/check.mjs --fast
